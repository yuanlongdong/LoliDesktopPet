.page { padding: 24rpx; color: #222; }
.title { font-size: 38rpx; font-weight: 700; margin-bottom: 12rpx; }
.subtitle { color: #666; font-size: 25rpx; margin-bottom: 28rpx; }
.status { padding: 18rpx; border-radius: 12rpx; background: #f2f4f7; margin-bottom: 18rpx; }
.event { min-height: 72rpx; padding: 18rpx; background: #fff4e8; border-radius: 12rpx; color: #222; margin-bottom: 22rpx; }
.hint { font-size: 23rpx; line-height: 1.6; color: #777; margin-bottom: 28rpx; }
button { margin-top: 16rpx; }
