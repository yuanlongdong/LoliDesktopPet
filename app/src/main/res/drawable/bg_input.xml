<?xml version="1.0" encoding="utf-8"?>
<!-- 直播联动设置里的输入框背景：深色圆角 + 细描边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1E2B47" />
    <stroke android:width="1dp" android:color="#3C5385" />
    <corners android:radius="10dp" />
    <padding
        android:left="10dp"
        android:top="0dp"
        android:right="10dp"
        android:bottom="0dp" />
</shape>
